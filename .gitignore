logs/
# Runtime SQLite db — group state and message history. store/ was already
# covered; this one was not, so `git add -A` would sweep it in.
# The -wal/-shm sidecars appear whenever SQLite runs in WAL mode.
nanoclaw.db
nanoclaw.db-*

# Groups - only track base structure and specific CLAUDE.md files
groups/*
!groups/main/
!groups/global/
!groups/copilot/
groups/main/*
groups/global/*
groups/copilot/*
!groups/main/CLAUDE.md
!groups/main/.mcp.json
!groups/global/CLAUDE.md
!groups/copilot/CLAUDE.md
!groups/copilot/.mcp.json
!groups/copilot/notifications.md
!groups/copilot/prompts/
groups/copilot/prompts/*
!groups/copilot/prompts/*.txt
!groups/copilot/prompts/README.md

